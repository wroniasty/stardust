{
  "mcpServers": {
    "godot-docs": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@nuskey8/godot-docs-mcp@latest"
      ],
      "env": {}
    },
    "godot": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@coding-solo/godot-mcp"
      ],
      "env": {
        "GODOT_PATH": "D:/Godot/Godot_v4.7.2-stable_win64_console.exe"
      }
    }
  }
}