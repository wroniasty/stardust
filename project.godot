; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="stardust"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Galaxy="*res://scripts/autoload/galaxy.gd"
StreamingManager="*res://scripts/autoload/streaming_manager.gd"
LootGenerator="*res://scripts/autoload/loot_generator.gd"

[audio]

buses/default_bus_layout="res://resources/audio/bus_layout.tres"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"mipmaps/generate": true
}

